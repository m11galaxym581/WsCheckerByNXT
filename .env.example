# ============================================================
#   BLAZE NXT — Environment Variables (.env.example)
#   Copy to `.env` for local development, or paste these into
#   Railway → Service → Variables for cloud deploys.
# ============================================================

# REQUIRED — Telegram bot token from @BotFather
TG_TOKEN=123456789:AAH_YourTokenHere_xxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED — Your numeric Telegram user ID from @userinfobot (owner)
OWNER_ID=123456789

# Optional — Web server port. Railway sets PORT automatically.
# PORT=9812

# Optional — Public URL of the dashboard/web panel. Used in Telegram
# "Open Web" buttons. On Railway it auto-detects RAILWAY_PUBLIC_DOMAIN,
# so you only need this for custom domains:
# DASHBOARD_URL=https://checker.yourdomain.com

# Optional — Long random secret for auth cookies / CSRF / backups.
# Defaults to TG_TOKEN if unset:
# WEB_SECRET=change-this-to-a-long-random-secret

# Optional — Production cookie mode (Secure cookies, HTTPS required).
# Railway domains are HTTPS so this is safe to enable:
# NODE_ENV=production

# Optional — Persistent data directory (users.json fallback, WhatsApp sessions,
# job state, backups). Railway: attach a volume (mounts at /data) and
# this is used automatically — no need to set DATA_DIR.
# DATA_DIR=/data

# Optional — PostgreSQL connection string. Railway injects DATABASE_URL
# automatically when you add a PostgreSQL service to the same project.
# When set, the whole database (users, subscriptions, vouchers, history,
# session metadata, stats, maintenance state) lives in Postgres instead of
# users.json. Table + schema are created automatically on first boot, and an
# existing users.json is imported once so nothing is lost.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — Postgres TLS. Railway Postgres has SSL enabled and the driver
# verifies the cert by default. Only set these if your host requires it:
# PGSSLMODE=require
# PGSSLROOTCERT=/path/to/ca.pem    (or "disable" to skip verification)

# Optional — Path to proxy list file (one proxy per line).
# PROXY_FILE=proxies.txt

# Optional — Single proxy URL (used when PROXY_MODE=single).
# PROXY_URL=http://user:pass@host:port
